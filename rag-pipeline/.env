# =============================================================================
# Production RAG Pipeline Configuration
# Based on Open Source Stack: Debezium, Kafka, Docling, Haystack, BGE-M3/Qwen3,
# Hugging Face TEI, Qdrant, vLLM, Valkey, NeMo Guardrails, Ragas, Langfuse + OTel, KEDA
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime & Core Service Configuration
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000
API_VERSION=v1
SERVICE_NAME=rag-pipeline

# -----------------------------------------------------------------------------
# Database (PostgreSQL 15 - Storage Authority Gate)
# -----------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=rag_pipeline_db
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@localhost:5433/rag_pipeline_db

# -----------------------------------------------------------------------------
# Tracing & Observability (Langfuse + OpenTelemetry / W3C Trace Context)
# -----------------------------------------------------------------------------
OTEL_SERVICE_NAME=rag-pipeline
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=always_on

# Langfuse (Open-source LLM engineering platform)
LANGFUSE_PUBLIC_KEY=pk-lf-016e60e1-ccf8-4e64-a243-c46447435f1e
LANGFUSE_SECRET_KEY=sk-lf-ce5a082e-bad5-413b-a8cc-1fbc73b62fb4
LANGFUSE_HOST=http://localhost:3000

# -----------------------------------------------------------------------------
# Layer 1: Change Feed (Debezium -> Kafka)
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CHANGE_FEED=rag.cdc.change-feed.v1
KAFKA_TOPIC_INGESTION=rag.ingestion.v1
KAFKA_TOPIC_DLQ=rag.dlq.v1
KAFKA_CONSUMER_GROUP=rag-pipeline-workers
DEBEZIUM_CONNECT_URL=http://localhost:8083

# -----------------------------------------------------------------------------
# Layer 2: Parse (Docling / Unstructured OSS fallback)
# -----------------------------------------------------------------------------
PARSER_ENGINE=docling
DOCLING_ENDPOINT=http://localhost:5001
UNSTRUCTURED_FALLBACK_ENDPOINT=http://localhost:8001
PARSER_MAX_CONCURRENCY=8

# -----------------------------------------------------------------------------
# Layer 3: Pipeline Framework (Haystack)
# -----------------------------------------------------------------------------
HAYSTACK_PIPELINE_CONFIG=config/pipeline.yaml
HAYSTACK_TELEMETRY=true

# -----------------------------------------------------------------------------
# Layer 4: Embedding Model & Serving (BGE-M3 / Qwen3-Embedding via Hugging Face TEI)
# -----------------------------------------------------------------------------
# Hugging Face Text Embeddings Inference (TEI)
EMBEDDING_PROVIDER=tei
EMBEDDING_SERVE_URL=http://localhost:8081
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# -----------------------------------------------------------------------------
# Layer 5: Rerank Model & Serving (bge-reranker-v2-m3 / Qwen3-Reranker via HF TEI)
# -----------------------------------------------------------------------------
RERANKER_PROVIDER=tei
RERANKER_SERVE_URL=http://localhost:8082
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K_INITIAL=50
RERANK_TOP_K_FINAL=5

# -----------------------------------------------------------------------------
# Layer 6: Index & Vector Storage (Qdrant in distributed mode / OpenSearch)
# -----------------------------------------------------------------------------
INDEX_ENGINE=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_corpus_v1
QDRANT_DISTANCE_METRIC=Cosine
QDRANT_SHARD_NUMBER=4
QDRANT_REPLICATION_FACTOR=2
SPARSE_BM25_ENABLED=true
HYBRID_FUSION_RRF_K=60

# -----------------------------------------------------------------------------
# Layer 7: Generation Model & Serving (Qwen3 / gpt-oss via vLLM)
# -----------------------------------------------------------------------------
GENERATION_ENGINE=vllm
VLLM_ENDPOINT=http://localhost:8000/v1
GENERATION_MODEL=Qwen/Qwen2.5-7B-Instruct
GENERATION_MAX_TOKENS=1024
GENERATION_TEMPERATURE=0.0
GENERATION_STREAMING=true

# -----------------------------------------------------------------------------
# Layer 8: Cache (Valkey in cluster mode)
# -----------------------------------------------------------------------------
VALKEY_URL=redis://localhost:6380/0
VALKEY_CLUSTER_NODES=
VALKEY_TTL_SECONDS=3600
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92

# -----------------------------------------------------------------------------
# Layer 9: Guardrails & Output Guard (NeMo Guardrails)
# -----------------------------------------------------------------------------
NEMO_GUARDRAILS_CONFIG_DIR=config/guardrails
NEMO_GUARDRAILS_ENDPOINT=http://localhost:8005
OUTPUT_GUARD_VALIDATE_CITATIONS=true
OUTPUT_GUARD_STRIP_MARKDOWN_LINKS=true

# -----------------------------------------------------------------------------
# Layer 10: Evals (Ragas CI/CD pipeline)
# -----------------------------------------------------------------------------
RAGAS_EVAL_SAMPLE_RATE=0.1
RAGAS_METRICS=faithfulness,answer_relevancy,context_precision,context_recall
RAGAS_GOLDEN_DATASET_PATH=config/golden_eval_set.json

# -----------------------------------------------------------------------------
# Layer 11: Orchestration & Autoscaling (Kubernetes + KEDA)
# -----------------------------------------------------------------------------
KEDA_KAFKA_LAG_THRESHOLD=50
KEDA_MIN_REPLICAS=1
KEDA_MAX_REPLICAS=20
