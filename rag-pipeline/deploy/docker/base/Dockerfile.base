FROM python:3.11-slim AS base

LABEL org.opencontainers.image.title="rag-pipeline-base" \
      org.opencontainers.image.description="Base runtime container for Production RAG Pipeline" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.authors="Jaydeep Vagh <jaydeep.9664920749@gmail.com>"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /bin/bash -m appuser

WORKDIR /app
USER 10001:10001
