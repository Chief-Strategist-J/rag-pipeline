# Environment Variables Validation Schema
# Declares types, required status, and defaults for the open-source RAG stack

type: object
required:
  - ENVIRONMENT
  - PORT
  - KAFKA_BOOTSTRAP_SERVERS
  - QDRANT_HOST
properties:
  ENVIRONMENT:
    type: string
    enum: [development, staging, production, test]
    default: development
  LOG_LEVEL:
    type: string
    enum: [debug, info, warn, error]
    default: info
  PORT:
    type: integer
    default: 8000
  HOST:
    type: string
    default: "0.0.0.0"
  API_VERSION:
    type: string
    default: "v1"

  # Tracing (Langfuse & OTel)
  OTEL_SERVICE_NAME:
    type: string
    default: "rag-pipeline"
  OTEL_EXPORTER_OTLP_ENDPOINT:
    type: string
  LANGFUSE_PUBLIC_KEY:
    type: string
  LANGFUSE_SECRET_KEY:
    type: string
  LANGFUSE_HOST:
    type: string
    default: "http://localhost:3000"

  # Change feed & Messaging (Debezium + Kafka)
  KAFKA_BOOTSTRAP_SERVERS:
    type: string
    default: "localhost:9092"
  KAFKA_TOPIC_CHANGE_FEED:
    type: string
    default: "rag.cdc.change-feed.v1"
  KAFKA_TOPIC_INGESTION:
    type: string
    default: "rag.ingestion.v1"
  KAFKA_CONSUMER_GROUP:
    type: string
    default: "rag-pipeline-workers"
  DEBEZIUM_CONNECT_URL:
    type: string
    default: "http://localhost:8083"

  # Parsing (Docling / Unstructured OSS)
  PARSER_ENGINE:
    type: string
    enum: [docling, unstructured]
    default: "docling"
  DOCLING_ENDPOINT:
    type: string
    default: "http://localhost:5001"
  UNSTRUCTURED_FALLBACK_ENDPOINT:
    type: string
    default: "http://localhost:8001"

  # Embedding & Serving (BGE-M3 / Qwen3 via HF TEI)
  EMBEDDING_PROVIDER:
    type: string
    enum: [tei, huggingface, openai]
    default: "tei"
  EMBEDDING_SERVE_URL:
    type: string
    default: "http://localhost:8081"
  EMBEDDING_MODEL:
    type: string
    default: "BAAI/bge-m3"

  # Rerank & Serving (bge-reranker-v2-m3 / Qwen3 via HF TEI)
  RERANKER_PROVIDER:
    type: string
    enum: [tei, huggingface, cohere]
    default: "tei"
  RERANKER_SERVE_URL:
    type: string
    default: "http://localhost:8082"
  RERANKER_MODEL:
    type: string
    default: "BAAI/bge-reranker-v2-m3"

  # Index (Qdrant distributed / OpenSearch)
  INDEX_ENGINE:
    type: string
    enum: [qdrant, opensearch]
    default: "qdrant"
  QDRANT_HOST:
    type: string
    default: "localhost"
  QDRANT_PORT:
    type: integer
    default: 6333
  QDRANT_COLLECTION_NAME:
    type: string
    default: "rag_corpus_v1"

  # Generation & Serving (Qwen3 / gpt-oss via vLLM)
  GENERATION_ENGINE:
    type: string
    enum: [vllm, openai, local]
    default: "vllm"
  VLLM_ENDPOINT:
    type: string
    default: "http://localhost:8000/v1"
  GENERATION_MODEL:
    type: string
    default: "Qwen/Qwen2.5-7B-Instruct"

  # Cache (Valkey cluster)
  VALKEY_URL:
    type: string
    default: "redis://localhost:6379/0"

  # Guardrails (NeMo Guardrails)
  NEMO_GUARDRAILS_ENDPOINT:
    type: string
    default: "http://localhost:8005"

  # Evals (Ragas)
  RAGAS_EVAL_SAMPLE_RATE:
    type: number
    default: 0.1

  # Autoscaling (KEDA)
  KEDA_KAFKA_LAG_THRESHOLD:
    type: integer
    default: 50
additionalProperties: false
